{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-to-image.local/schemas/asset-library/v1/commit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "operation", "createdAt", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "operation": {
      "enum": [
        "initialize_creation",
        "checkpoint_revision",
        "import_asset",
        "generation",
        "merge_library"
      ]
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": { "enum": ["creation", "prompt", "revision", "generation", "image_asset"] },
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    }
  }
}
