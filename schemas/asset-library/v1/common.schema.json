{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-to-image.local/schemas/asset-library/v1/common.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\).+$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetSha256", "roles"],
      "properties": {
        "assetSha256": { "$ref": "#/$defs/sha256" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["subject", "style", "composition", "palette", "other"]
          }
        },
        "guidance": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "roles": { "const": ["other"] } },
            "required": ["roles"]
          },
          "then": {
            "required": ["guidance"],
            "properties": {
              "guidance": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  }
}
