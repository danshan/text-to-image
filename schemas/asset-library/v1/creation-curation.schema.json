{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-to-image.local/schemas/asset-library/v1/creation-curation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entityRevision",
    "creationId",
    "title",
    "status",
    "tags",
    "favorite",
    "note",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entityRevision": { "type": "integer", "minimum": 1 },
    "creationId": { "$ref": "common.schema.json#/$defs/uuid" },
    "title": { "type": "string" },
    "status": { "enum": ["active", "shelved"] },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "favorite": { "type": "boolean" },
    "note": { "type": "string" },
    "providerPreference": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,49}$" }
    },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
